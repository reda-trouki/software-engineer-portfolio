# Copy to .env.local and fill in.

# PIN used the FIRST time the app runs (4-8 digits). After that it is stored
# hashed in the data file and can be changed from Admin > Profile & security.
ADMIN_PIN=1234

# Long random string used to sign the admin session cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: where db.json lives (use a persistent disk/volume in production).
# DATA_DIR=./data

# Optional: email me when someone uses the contact form (messages are always
# saved in Admin > Messages). Example for Gmail: create an "App password"
# (Google account > Security > 2-Step Verification > App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# CONTACT_TO=you@gmail.com
